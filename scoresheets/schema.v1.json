{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shelfpick.example/scoresheets/schema.v1.json",
  "title": "ShelfPick scoresheet template, format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "bgg_id", "name", "supported_players", "win_condition", "rounds", "categories", "tie_breakers", "source", "notes"],
  "properties": {
    "format_version": { "const": 1 },
    "bgg_id": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "supported_players": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "win_condition": { "enum": ["highest", "lowest", "cooperative", "target"] },
    "target_score": { "type": "number" },
    "rounds": { "type": ["integer", "null"], "minimum": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "tie_breakers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "result_bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min_total", "label"],
        "properties": {
          "min_total": { "type": "number" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rulebook_title", "edition_or_year", "checked_against_rulebook"],
      "properties": {
        "rulebook_title": { "type": "string", "minLength": 1 },
        "edition_or_year": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "checked_against_rulebook": { "type": "boolean" }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "help", "type", "points_per", "allow_negative", "scope"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "help": { "type": "string", "minLength": 1 },
        "type": { "enum": ["number", "count", "boolean"] },
        "points_per": { "type": "number" },
        "allow_negative": { "type": "boolean" },
        "scope": { "enum": ["once", "per_round"] },
        "tie_break_direction": { "enum": ["higher", "lower"] }
      }
    }
  }
}
