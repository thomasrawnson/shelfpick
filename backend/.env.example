APP_ENV=development

DATABASE_URL=postgresql+psycopg://boardgamepicker:boardgamepicker_dev@localhost:5433/boardgamepicker_commercial

JWT_SECRET=replace-with-a-long-random-secret

ACCESS_TOKEN_MINUTES=1440

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_PICKER_ENABLED=false
AI_PICKER_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
AI_PICKER_TIMEOUT_SECONDS=180

# Voting join links and QR codes use this origin. For physical-phone testing,
# replace localhost with the computer's phone-reachable LAN address and add the
# same frontend origin to CORS_ORIGINS.
FRONTEND_URL=http://localhost:5173

# Optional for local development; required in production.
# Keep the real BoardGameGeek token out of source control.
BGG_API_TOKEN=

# Production only. Keep the API key out of source control.
RESEND_API_KEY=
EMAIL_FROM=ShelfPick <accounts@mail.example.com>
