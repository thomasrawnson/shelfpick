VITE_API_BASE_URL=https://board-game-picker-api.onrender.com

# Tags PostHog events as production (SP-ANL-001). Any other value or unset tags them dev.
VITE_ANALYTICS_ENV=production

# SP-PRO-01: RevenueCat public iOS SDK key (appl_...), set by the owner for the
# build that sells Pro. Empty means no purchases. Purchases also need
# VITE_PURCHASES_ENABLED=true, which the release lane sets for purchases:true.
VITE_REVENUECAT_IOS_API_KEY=appl_bYmpyOqbEKquhzqcvppewYOauSA
