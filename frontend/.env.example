VITE_API_BASE_URL=http://127.0.0.1:8000
# Fail closed. Set true only for an isolated owner/legal-review preview.
VITE_LEGAL_DRAFTS_ENABLED=false
# Fail closed. Set true only after the exact public Privacy Policy and Terms
# URLs have been owner-approved and verified reachable without authentication.
VITE_PUBLIC_LEGAL_LINKS_ENABLED=false
# Release builds only: tags analytics events as production. Unset or any other value tags them dev.
VITE_ANALYTICS_ENV=
# RevenueCat public SDK key for iOS (starts with appl_; public by design, not the secret key).
# Leave empty and the app offers no purchases. Purchases also stay closed unless
# VITE_PUBLIC_LEGAL_LINKS_ENABLED is true.
VITE_REVENUECAT_IOS_API_KEY=
